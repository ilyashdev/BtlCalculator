<!--
    The main view (legacy MainPage.xaml): top bar with the navigation button, mode title, "keep on top" and history
    buttons, the current mode view, and the navigation pane with the Calculator and Converter groups and Settings.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Calculator.UI.Localization"
             xmlns:platform="clr-namespace:Calculator.UI.Platform"
             xmlns:vm="clr-namespace:Calculator.UI.ViewModels"
             x:Class="Calculator.UI.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource PageBackground}"
             Foreground="{DynamicResource TextPrimary}">

    <UserControl.Resources>
        <!-- A navigation pane entry: a group header, or a mode with an accent bar when selected, its glyph and name -->
        <DataTemplate x:Key="NavigationItemTemplate" x:DataType="vm:NavigationItemViewModel">
            <Panel>
                <TextBlock Classes="paneTitle" Text="{Binding Title}" IsVisible="{Binding IsHeader}" Margin="16,16,0,8" />
                <Button Classes="key subtle navItem" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsMode}" Height="40" Margin="4,2"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).NavigateCommand}"
                        CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="4,44,*">
                        <Border Grid.Column="0" Width="3" Height="16" CornerRadius="1.5" VerticalAlignment="Center"
                                Background="{DynamicResource AccentBrush}" IsVisible="{Binding IsSelected}" />
                        <TextBlock Grid.Column="1" Classes="icon" Text="{Binding Glyph}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Panel>
        </DataTemplate>
    </UserControl.Resources>

    <Panel>
        <Grid RowDefinitions="48,*">
<!--
                Top bar. The title takes the room that is left and is shortened with "…" in narrow windows, so the
                buttons on the right (the graph / equations switch, history) always stay whole.
            -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
                <Button x:Name="NavigationButton" Grid.Column="0" Classes="key subtle icon topBar"
                        Content="{x:Static platform:SystemGlyphs.Navigation}"
                        Command="{Binding ToggleNavigationCommand}"
                        AutomationProperties.Name="{loc:Localize FlyoutNav.AutomationName}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                               FontSize="20" VerticalAlignment="Center" Margin="8,0,4,2" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="KeepOnTopButton" Classes="key subtle icon topBar" Click="OnKeepOnTopClicked" />
                </StackPanel>
                <ContentControl x:Name="TopBarAccessoryHost" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0" />
                <Button x:Name="HistoryButton" Grid.Column="3" Classes="key subtle icon topBar" Content="&#xF47F;"
                        Click="OnHistoryClicked" ToolTip.Tip="{loc:Localize HistoryButton.ToolTip}" />
            </Grid>

            <ContentControl x:Name="ModeHost" Grid.Row="1" />
        </Grid>

        <!-- Navigation pane over the content -->
        <Border x:Name="NavigationScrim" Background="{DynamicResource ScrimBrush}" IsVisible="False"
                PointerPressed="OnScrimPressed" />
        <Border x:Name="NavigationPane" HorizontalAlignment="Left" Width="320" IsVisible="False" BorderThickness="0,1,1,1"
                BorderBrush="{DynamicResource KeyBorder}" Background="{DynamicResource PaneBackground}" CornerRadius="0,8,8,0">
            <Grid RowDefinitions="48,*,1,Auto">
                <Button Grid.Row="0" Classes="key subtle icon topBar" HorizontalAlignment="Left"
                        Content="{x:Static platform:SystemGlyphs.Navigation}" Command="{Binding ToggleNavigationCommand}" />
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource NavigationItemTemplate}" />
                </ScrollViewer>
                <Border Grid.Row="2" Background="{DynamicResource KeyBorder}" />
                <ItemsControl Grid.Row="3" Margin="0,4,0,8" ItemsSource="{Binding FooterItems}"
                              ItemTemplate="{StaticResource NavigationItemTemplate}" />
            </Grid>
        </Border>
    </Panel>
</UserControl>
