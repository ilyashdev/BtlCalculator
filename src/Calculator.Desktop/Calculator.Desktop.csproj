<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Desktop app: Windows, Linux and macOS.
    Run:     dotnet run (project src/Calculator.Desktop)
    Publish: dotnet publish src/Calculator.Desktop -c Release -r <win-x64 | linux-x64 | osx-arm64>
             (Native AOT: one self-contained binary; build on the target OS, Linux needs clang.)
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- On Windows the app uses Windows APIs (the share sheet), so it is built for Windows there. -->
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Calculator.Desktop</RootNamespace>
    <AssemblyName>BtlCalculator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Calculator.UI\Calculator.UI.csproj" />
  </ItemGroup>

</Project>
