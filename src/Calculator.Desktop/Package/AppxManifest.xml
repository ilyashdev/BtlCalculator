<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (MSIX) of the Windows app; tools/New-MsixPackage.ps1 fills in the $...$ values and packs the
  Native AOT build with it. The identity comes from the app's page in Partner Center (Product identity).
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="$Architecture$" />

  <Properties>
    <!-- The name reserved in Partner Center; the Start menu shows the name of the application below -->
    <DisplayName>Better than Legacy Calculator</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- The same minimum as the app (SupportedOSPlatformVersion of Calculator.Desktop) -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- The languages of the app (Calculator.UI/Resources/Strings) -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ru-RU" />
    <Resource Language="ar" />
    <Resource Language="es-ES" />
    <Resource Language="fr-FR" />
    <Resource Language="hi-IN" />
    <Resource Language="zh-Hans" />
  </Resources>

  <Applications>
    <Application Id="BtlCalculator" Executable="BtlCalculator.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Calculator"
                          Description="A calculator with standard, scientific, programmer and graphing modes, unit and currency converters."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Currency rates (ExchangeRate-API) -->
    <Capability Name="internetClient" />
    <!-- A regular desktop app (Win32), not a sandboxed one -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
